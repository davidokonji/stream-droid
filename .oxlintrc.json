{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-hooks", "typescript", "unicorn", "oxc", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "off"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": { "version": "19.2.0" }
  },
  "ignorePatterns": ["node_modules", "public", "scrcpy-server-*", "*.d.ts"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "off",
    "no-underscore-dangle": ["warn", { "allow": ["__dirname", "__filename"] }],
    "react/react-in-jsx-scope": "off",
    "react/no-unknown-property": "off"
  }
}
