#!/bin/sh
# Bare-name launcher for the stream-droid server-ensure helper (health-check +
# headless start if it isn't up). Same rationale as bin/drive: a bare name keeps
# $CLAUDE_PLUGIN_ROOT out of the command so it doesn't prompt on every call.
self=$0
case $self in
  */*) ;;
  *) self=$(command -v -- "$self") ;;
esac
root=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)
exec node "$root/skills/drive/scripts/ensure-server.mjs" "$@"
