{
  "name": "stream-droid",
  "version": "0.3.1",
  "description": "Stream a running Android emulator or device to the browser and drive it (tap/swipe/type/keys) — for humans and AI agents. TypeScript + bun.",
  "type": "module",
  "license": "MIT",
  "author": "David Okonji",
  "homepage": "https://github.com/davidokonji/stream-droid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidokonji/stream-droid.git"
  },
  "bugs": {
    "url": "https://github.com/davidokonji/stream-droid/issues"
  },
  "keywords": [
    "android",
    "emulator",
    "adb",
    "scrcpy",
    "screen-mirror",
    "screen-streaming",
    "uiautomator",
    "device-automation",
    "ui-automation",
    "appium-alternative",
    "agent",
    "ai-agent",
    "bun"
  ],
  "bin": {
    "stream-droid": "bin/stream-droid.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "public",
    "skills",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    ".bun-version"
  ],
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:css": "tailwindcss -i src/ui/styles.css -o public/app.css --minify",
    "build:client": "bun build src/client.tsx --outfile public/client.js --target browser --production",
    "build": "bun run build:css && bun run build:client",
    "start": "bun run build && node bin/stream-droid.mjs",
    "docs:api": "bun scripts/typedoc-readme.mjs && typedoc",
    "docs:preview": "bun run docs:api && bunx serve docs/api",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "check": "oxlint src && oxfmt --check src && bunx tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "jmuxer": "^2.1.1",
    "localtunnel": "^2.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "ts-pattern": "^5.9.0",
    "tsx": "^4.23.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.12",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.6.0"
  }
}
